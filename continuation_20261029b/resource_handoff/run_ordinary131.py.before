from pathlib import Path
import subprocess,concurrent.futures,json,time,sys
W=Path(__file__).resolve().parent;sys.path.insert(0,str(W));from unit_arithmetic import lit
jobs=json.loads((W/'ordinary131_jobs.json').read_text());jobs.sort(key=lambda j:(j['start'],j['N']));tt=time.monotonic()
def one(j):
 n,a,b=j['N'],j['start'],j['end'];H=W/f'full{n}';log=H/f'chunk_{a}.log'
 if not(log.exists()and'AUDIT_ACTUAL_HECKE_JETS_COMPLETE'in log.read_text()):
  with log.open('w')as f:r=subprocess.run(['magma','-b',f'Start:={a}',f'End:={b}',str(H/'stage2_chunk.m')],stdout=f,stderr=subprocess.STDOUT)
 s=log.read_text();ok='AUDIT_ACTUAL_HECKE_JETS_COMPLETE'in s and not any(e in s for e in['Runtime error','User error','Assertion failed']);print('S18_CHUNK_COMPLETE',n,a,b,ok,'wall',round(time.monotonic()-tt,1),flush=True);return j|{'status':'PASS'if ok else'FAILED'}
with concurrent.futures.ThreadPoolExecutor(max_workers=6)as ex:done=list(ex.map(one,jobs))
(W/'ordinary131_job_results.json').write_text(json.dumps(done,indent=2)+'\n')
for n in sorted(set(j['N']for j in jobs)):
 H=W/f'full{n}';js=sorted([j for j in done if j['N']==n],key=lambda j:j['start']);assert all(j['status']=='PASS'for j in js)
 parts=[]
 for name in ['SourceMetadata','SourceRecords','SourceHeckeRecords']:
  pieces=[]
  for j in js:
   t=(H/f"hecke_jets_{j['start']}.m").read_text();v=t.split(name+':=',1)[1].split(';',1)[0].strip();assert v.startswith('[*')and v.endswith('*]');pieces.append(v[2:-2].strip())
  parts.append(name+':=[*'+','.join(v for v in pieces if v)+'*];')
 (H/'hecke_jets.m').write_text('\n'.join(parts)+'\n')
 print('S18_JETS_MERGED',n,len(lit((H/'hecke_jets.m').read_text(),'SourceMetadata')),flush=True)
print('S18_ALL_NEW_ORDINARY_JETS_COMPLETE',flush=True)
